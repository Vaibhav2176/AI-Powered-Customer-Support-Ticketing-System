<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Build_Case_Triage_Output</name>
        <label>Build Case Triage Output</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>CaseSummaryOutput</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Summary_Text_Formula</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>Autolaunched Agentforce Action Flow invoked by AI Customer Support Assistant to retrieve Case details, classify Support Category and Priority, and return structured troubleshooting steps.</description>
    <formulas>
        <name>Summary_Text_Formula</name>
        <dataType>String</dataType>
        <expression>"Case " &amp; {!Get_Case_Record.CaseNumber} &amp; " [" &amp; TEXT({!Get_Case_Record.Priority}) &amp; " Priority | Issue Type: " &amp; TEXT({!Get_Case_Record.Issue_Type__c}) &amp; "] - Subject: " &amp; {!Get_Case_Record.Subject} &amp; ". Suggested Reply: " &amp; {!Get_Case_Record.AI_Suggested_Reply__c}</expression>
    </formulas>
    <label>Case Summary Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Case_Record</name>
        <label>Get Case Record</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Build_Case_Triage_Output</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>CaseRecordId</elementReference></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start><locationX>50</locationX><locationY>0</locationY><connector><targetReference>Get_Case_Record</targetReference></connector></start>
    <status>Active</status>
    <variables><name>CaseRecordId</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
    <variables><name>CaseSummaryOutput</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
</Flow>
